# Single-user login
APP_EMAIL=llakshitmathur239@gmail.com
# Prefer a scrypt hash in production. APP_PASSWORD is supported for initial setup.
APP_PASSWORD_HASH=
APP_PASSWORD=
APP_SESSION_SECRET=
# SESSION_SECRET is accepted as a compatibility alias.
SESSION_SECRET=

# Vercel Blob persistence - REQUIRED for production resume storage
# Get these from Vercel Dashboard > Storage > Blob > "Connect Database"
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Scheduled scans security
CRON_SECRET=

# Optional AI provider used for evidence-backed matching and writing
AI_API_KEY=
AI_MODEL=
AI_API_URL=https://api.openai.com/v1/chat/completions

# Optional canonical deployment origin for same-origin validation
APP_ORIGIN=
